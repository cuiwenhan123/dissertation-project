ROBUSTNESS_HOST=127.0.0.1
ROBUSTNESS_PORT=8877
ROBUSTNESS_LOG_LEVEL=INFO
ROBUSTNESS_USE_REAL_MODELS=1
ROBUSTNESS_ALLOW_MODEL_DOWNLOAD=0
ROBUSTNESS_COCO_VAL2017_ROOT=/absolute/path/to/coco_val2017
ROBUSTNESS_DETR_MODEL_PATH=/absolute/path/to/detr-resnet-50
ROBUSTNESS_FASTER_RCNN_MODEL_PATH=/absolute/path/to/fasterrcnn-resnet50-fpn-coco.pth
ROBUSTNESS_BUILTIN_DATASET_PATH=/absolute/path/to/coco128.zip
ROBUSTNESS_MAX_REQUEST_BYTES=134217728

# Keep Hugging Face in offline mode when weights are stored under ./models.
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
TRANSFORMERS_VERBOSITY=error
